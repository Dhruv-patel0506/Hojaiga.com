# Hojaiga: copy this file to .env and fill in ONE of the keys below. Never commit your .env.

# The teacher (strongest first). Claude on your own Anthropic key:
HOJAIGA_CLAUDE_KEY=
# HOJAIGA_CLAUDE_MODEL=claude-opus-5-5
# HOJAIGA_CLAUDE_BUDGET_USD=2          # daily spending cap; calls stop when it is reached

# Free alternatives (used when there is no Claude key, or after it):
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=

# How the brain uses the teacher: auto (teacher until the brain is ready, then local) | teacher | local | off
HOJAIGA_BRAIN_MODE=auto
# HOJAIGA_TEACHER_ORDER=claude,cloud
