{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false,
    "noImplicitAny": false
  },
  "include": ["src/**/*", "WindowManager.ts", "SafeOSController.ts", "LivePerception.ts", "TeachingStateMachine.ts", "OverlayEngine.ts", "index.ts", "InteractiveTutorWrapper.ts", "InteractiveInputHandler.ts"],
  "exclude": ["gemini-code-*.ts", "ultron_teacher.ts", "virtual_cursor_controller.ts", "vision_llm.ts", "live_teacher.ts", "universal_types.ts", "os_controller.ts"]
}
