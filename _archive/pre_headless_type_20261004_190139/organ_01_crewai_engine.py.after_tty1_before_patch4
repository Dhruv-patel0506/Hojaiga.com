            return f"[{_ts()}] SUCCESS: Dragged from ({start_x}, {start_y}) to ({end_x}, {end_y}) ({why_d})."
        except Exception as e:
            return f"[{_ts()}] Error dragging mouse: {e}"
        finally:
            _canvas_session_exit(_sess)

