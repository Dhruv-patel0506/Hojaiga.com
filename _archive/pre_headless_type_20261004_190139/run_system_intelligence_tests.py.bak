# POPUP HANDLER (organ_29)
# ═══════════════════════════════════════════════════════════════════════

def _enum_visible_windows() -> List[Dict[str, Any]]:
    user32 = ctypes.windll.user32
    found: List[Dict[str, Any]] = []

    @ctypes.WINFUNCTYPE(ctypes.c_bool, ctypes.c_void_p, ctypes.c_void_p)
    def _cb(hwnd, _lParam):
        if not user32.IsWindowVisible(hwnd):
            return True
        length = user32.GetWindowTextLengthW(hwnd)
        if length == 0:
            return True
        buf = ctypes.create_unicode_buffer(length + 1)
        user32.GetWindowTextW(hwnd, buf, length + 1)
        cls = ctypes.create_unicode_buffer(256)
        user32.GetClassNameW(hwnd, cls, 256)
        import ctypes.wintypes as wt
        r = wt.RECT()
        user32.GetWindowRect(hwnd, ctypes.byref(r))
        found.append({"hwnd": hwnd, "title": buf.value, "class": cls.value,
                      "box": (r.left, r.top, r.right, r.bottom)})
        return True

    user32.EnumWindows(_cb, 0)
    return found


def test_p1_popup_window_classification() -> TestOutcome:
    """P1: Organ-29 enumerates live windows and classifies modal vs in-window popups"""
    from core_organs.organ_29_popup_handler import DesktopInteractionManager

    mgr = DesktopInteractionManager()
    windows = _enum_visible_windows()
    assert windows, "no visible windows enumerated"
    modal_classes = {"#32770", "TaskDialogWindow", "WindowsForms10.Window"}
    modals = [w for w in windows if w["class"] in modal_classes]
    # In-window modal discovery against the foreground window (must not crash, returns list)
    fg = ctypes.windll.user32.GetForegroundWindow()
    inwin = mgr.find_in_window_modals(fg) if fg else []
    assert isinstance(inwin, list)
    return TestOutcome(
        passed=len(windows) > 0,
        evidence=(
            f"{len(windows)} visible windows enumerated, {len(modals)} classic modal HWNDs, "
            f"{len(inwin)} in-window modals found on foreground window "
            f"('{(windows[0]['title'][:30] if windows else '')}')"
        ),
        metrics={"windows_seen": len(windows), "classic_modals": len(modals),
                 "in_window_modals": len(inwin)},
    )


def test_p2_popup_mitigation_engine() -> TestOutcome:
    """P2: Organ-29 mitigation engine resolves synthetic + live popups (dry-run safe)"""
    from core_organs.organ_29_popup_handler import (
        DesktopInteractionManager, WindowNode, WindowRect, WindowType,
    )

    mgr = DesktopInteractionManager()
    mitigate_live = os.environ.get("HOJAIGA_TEST_POPUP_MITIGATE") == "1"

    # Synthetic popups: exercises the decision engine WITHOUT touching real apps
    synthetics = [
        ("Save changes before closing?", WindowType.CONFIRMATION, "Cancel"),
        ("Microsoft Store Update", WindowType.MODAL_WINDOW, "Close"),
        ("Allow notifications?", WindowType.BROWSER_PROMPT, "Block"),
    ]
    decisions = []
    resolved = 0
    for title, wtype, expected_hint in synthetics:
        node = WindowNode(
            handle=0, parent_handle=None, owner_handle=None, process_id=os.getpid(),
            title=title, class_name="#32770", win_type=wtype,
            bounds=WindowRect(left=400, top=200, right=900, bottom=500),
            is_visible=True, has_focus=True, text_content=title, extra_data={},
        )
        t0 = time.perf_counter()
        success, x, y, action = mgr.resolve_and_mitigate(node)
        ms = (time.perf_counter() - t0) * 1000
        decisions.append(f"'{title}'->{action or 'no-action'} ({ms:.1f}ms)")
        if action:
            resolved += 1
    # Live scan of foreground window: enumerate only unless explicitly allowed to act
    fg = ctypes.windll.user32.GetForegroundWindow()
    live_resolved = 0
    if fg and mitigate_live:
        live_resolved = mgr.scan_and_resolve_any(fg)
    return TestOutcome(
        passed=resolved >= 2,
        evidence=(
            f"{resolved}/{len(synthetics)} popup types produced a mitigation decision; "
            f"live mitigation={'ENABLED' if mitigate_live else 'DRY-RUN'}"
            f"{' resolved=' + str(live_resolved) if mitigate_live else ''} | " + " ; ".join(decisions)
        ),
        metrics={"decisions_made": resolved, "modes_tested": len(synthetics)},
    )


