def test_d1_batch_element_roundtrip() -> TestOutcome:
    """D1: DAP batch-store 200 element profiles, then read them back from the DB"""
    from core_organs.organ_24_dap import DAPBridge

    dap = DAPBridge()
    app_name = f"__test_batch_{uuid.uuid4().hex[:8]}__"
    elements = [
        {
            "element_name": f"btn_{i}", "element_type": "Button", "control_type": "Button",
            "visual_description": "synthetic test button", "region_x": 10 + i, "region_y": 20 + i,
            "region_w": 80, "region_h": 24, "tab_location": "", "group_location": "",
            "spatial_context": None,
        }
        for i in range(200)
    ]
    t0 = time.perf_counter()
    written = dap.store_elements_batch(app_name, elements)
    write_ms = (time.perf_counter() - t0) * 1000
    from core_organs.database_manager import DatabaseManager
    db = DatabaseManager()
    rows = db.get_element_profiles(app_name) or []
    # cleanup
    try:
        def _del(conn):
            cur = conn.cursor()
            cur.execute("DELETE FROM element_profiles WHERE app_name = ?", (app_name,))
            conn.commit()
            return True
        db._safe_call(_del)
    except Exception:
        pass
    ok = written >= 150 and len(rows) >= 150
    return TestOutcome(
        passed=ok,
        evidence=(
            f"{written}/200 profiles written in {write_ms:.0f} ms "
            f"({write_ms / max(written,1):.2f} ms/element); {len(rows)} read back"
        ),
        metrics={"written": written, "read_back": len(rows),
                 "ms_per_element": round(write_ms / max(written, 1), 3)},
    )


def test_d2_modal_and_cookie_roundtrip() -> TestOutcome:
    """D2: Popup-resolution cache + session cookie persistence round-trip"""
    from core_organs.database_manager import DatabaseManager

    db = DatabaseManager()
    key = f"__t_{uuid.uuid4().hex[:8]}__"
    db.store_modal_resolution(key, "click:Cancel")
    got = db.get_modal_resolution(key)
    cookie_ok = True
    try:
        db.store_session_cookies(key, [{"name": "sid", "value": "abc", "domain": ".test"}])
        cookies = db.get_session_cookies(key)
        cookie_ok = bool(cookies)
    except Exception as exc:
        cookie_ok = False
        got = f"{got} (cookie error: {exc})"
    ok = got == "click:Cancel" and cookie_ok
    return TestOutcome(
        passed=bool(ok),
        evidence=f"modal resolution read-back={'OK' if got == 'click:Cancel' else repr(got)}; cookies={'OK' if cookie_ok else 'FAIL'}",
        metrics={},
    )


