def test_h1_organ_import_health() -> TestOutcome:
    """H1: Every core organ module imports cleanly with its main symbol present"""
    import importlib
    ok_count, failures = 0, []
    t0 = time.perf_counter()
    for mod_name, symbol in ORGAN_IMPORTS:
        try:
            mod = importlib.import_module(mod_name)
            if symbol and not hasattr(mod, symbol):
                failures.append(f"{mod_name}: missing {symbol}")
            else:
                ok_count += 1
        except Exception as exc:
            failures.append(f"{mod_name}: {type(exc).__name__}: {exc}")
    total = len(ORGAN_IMPORTS)
    return TestOutcome(
        passed=ok_count == total,
        evidence=f"{ok_count}/{total} organs import clean ({(time.perf_counter()-t0)*1000:.0f} ms cold-import sweep)"
                 + ("; FAILURES: " + " | ".join(failures[:5]) if failures else ""),
        metrics={"organs_healthy": f"{ok_count}/{total}"},
    )


# ═══════════════════════════════════════════════════════════════════════
# DESKTOP AUTONOMY LOOP (desktop_grounding) + APP INTELLIGENCE (organ_47)
# ═══════════════════════════════════════════════════════════════════════

def test_g1_grounding_ladder_honesty() -> TestOutcome:
    """G1: desktop_grounding perceives a real app AND reports tiers honestly"""
    import subprocess
    from core_organs.desktop_grounding import (
        DesktopGrounding, HAS_UIA, HAS_TORCH, HAS_PYTESSERACT,
    )

    notepads_before = _windows_of_class("Notepad")           # the user's own Notepad is never touched
    proc = subprocess.Popen(["notepad.exe"])
    try:
        _ready, _blocked = _vision_ready_or_blocked(300.0)   # warmup happens off the goal path; tests wait for it
        if not _ready:
            return _blocked
        g = DesktopGrounding()
        hwnd = None
        deadline = time.perf_counter() + 10
        while time.perf_counter() < deadline:
            new_np = _windows_of_class("Notepad") - notepads_before
            if new_np:
                hwnd = g.find_window("notepad")
                break
            time.sleep(0.3)
        if not hwnd:
            return TestOutcome(passed=False, env_blocked=True,
                              evidence="notepad window never appeared (environment)",
                              metrics={})
        time.sleep(0.6)
        # Hunt for a target that structurally cannot exist -> forces escalation
        # to OCR/vision so we can verify the ladder REPORTS what it could run.
        _h, elements, report = g.ground("notepad", target_text="zz_absent_widget_zz",
                                        max_tier=4)
        tiers_ran = report.get("tiers_ran", [])
        tiers_skipped = report.get("tiers_skipped", [])
        # HONESTY INTEGRITY: a tier may only appear in tiers_ran if its engine is
        # actually present. Claiming vision without torch would be a fabrication.
        integrity, integrity_detail = True, []
        if not HAS_TORCH and "vision" in tiers_ran:
            integrity = False; integrity_detail.append("claimed vision without torch")
        if not HAS_PYTESSERACT and "ocr" in tiers_ran:
            integrity = False; integrity_detail.append("claimed ocr without pytesseract")
        if not HAS_UIA and "uia" in tiers_ran:
            integrity = False; integrity_detail.append("claimed uia without uiautomation")
        got_controls = len(elements) > 0
        escalated = bool(report.get("escalated"))
        passed = got_controls and integrity and escalated
        return TestOutcome(
            passed=passed,
            evidence=(
                f"notepad grounded to {len(elements)} elements via tiers {tiers_ran}; "
                f"target-hunt escalated={escalated}; skipped={tiers_skipped}; "
                f"honesty-integrity={'OK' if integrity else 'VIOLATED:' + ','.join(integrity_detail)} "
                f"(torch={HAS_TORCH}, ocr={HAS_PYTESSERACT}, uia={HAS_UIA})"
            ),
            metrics={"elements": len(elements), "tiers_ran": ",".join(tiers_ran) or "-",
                     "escalated": escalated, "integrity": integrity},
        )
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=3)
        except Exception:
            pass
        _close_new_windows_of(notepads_before, "Notepad")


def test_v1_verifier_verdict_logic() -> TestOutcome:
    """V1: DesktopVerifier emits PASS / NO_CHANGE / WRONG_STATE on live + synthetic state"""
    from core_organs.desktop_grounding import DesktopVerifier, Snapshot, GroundedElement

    v = DesktopVerifier()

    def mk(ids, title):
        return Snapshot(title=title, element_ids=list(ids), region_hash="")

    checks, detail = [], []
    # 1) structure changed, no explicit expectation -> PASS (something happened)
    vd, ev = v.verdict({}, mk(["el_1", "el_2"], "App"), mk(["el_1", "el_2", "el_3"], "App"), [])
    checks.append(("pass_on_change", vd == "PASS")); detail.append(f"change->{vd}")
    # 2) identical -> NO_CHANGE (never claim success on a dead click)
    vd, ev = v.verdict({}, mk(["el_1"], "App"), mk(["el_1"], "App"), [])
    checks.append(("nochange_on_identical", vd == "NO_CHANGE")); detail.append(f"same->{vd}")
    # 3) postcondition element_appeared satisfied -> PASS
    els = [GroundedElement(id="e1", name="Save As", role="button", bbox=(0, 0, 10, 10), tier="uia")]
    vd, ev = v.verdict({"element_appeared": "Save As"}, mk(["e0"], "App"), mk(["e0", "e1"], "App"), els)
    checks.append(("pass_on_expect_met", vd == "PASS")); detail.append(f"expect-met->{vd}")
    # 4) state moved but the wanted element is absent -> WRONG_STATE (not PASS)
    vd, ev = v.verdict({"element_appeared": "zzz"}, mk(["e0"], "App"), mk(["e0", "e9"], "App"), els)
    checks.append(("wrong_state", vd == "WRONG_STATE")); detail.append(f"wrong->{vd}")
    # 5) title_contains postcondition satisfied -> PASS
    vd, ev = v.verdict({"title_contains": "*"}, mk(["x"], "Doc"), mk(["x"], "Doc *"), [])
    checks.append(("title_expect_pass", vd == "PASS")); detail.append(f"title->{vd}")
    # 6) element_disappeared satisfied -> PASS
    vd, ev = v.verdict({"element_disappeared": "Loading"}, mk(["e0"], "App"), mk(["e1"], "App"), els)
    checks.append(("disappeared_pass", vd == "PASS")); detail.append(f"disappeared->{vd}")
    # 7) file_created / file_saved satisfied -> PASS
    import tempfile
    with tempfile.NamedTemporaryFile(delete=False) as tf:
        tf_name = tf.name
    try:
        vd, ev = v.verdict({"file_created": tf_name}, mk(["e0"], "App"), mk(["e0"], "App"), els)
        checks.append(("file_created_pass", vd == "PASS")); detail.append(f"file_created->{vd}")
    finally:
        try:
            os.remove(tf_name)
        except Exception:
            pass

    hits = sum(1 for _, ok in checks if ok)
    failed = [n for n, ok in checks if not ok]
    return TestOutcome(
        passed=hits == len(checks),
        evidence=f"{hits}/{len(checks)} verdict transitions correct: " + " ; ".join(detail)
                 + ((" | FAILED: " + ",".join(failed)) if failed else ""),
        metrics={"verdict_checks": f"{hits}/{len(checks)}"},
    )


def test_p3_popup_tier3_timeout_cap() -> TestOutcome:
    """P3: organ_29 Tier-3 gatekeeper is hard-capped so a dead LLM can't stall the loop"""
    from core_organs.organ_29_popup_handler import (
        DesktopInteractionManager, WindowNode, WindowRect, WindowType,
        GATEKEEPER_TIER3_TIMEOUT_S,
    )

    mgr = DesktopInteractionManager()
    cap_ok = 0.5 <= GATEKEEPER_TIER3_TIMEOUT_S <= 5.0
    # Unresolvable synthetic modal: handle 0 (no real tree), unique title (Tier-2
    # cache miss) -> must fall all the way through Tier-3 to the Tier-4 fallback.
    node = WindowNode(
        handle=0, parent_handle=None, owner_handle=None, process_id=os.getpid(),
        title="zz-unresolvable-" + uuid.uuid4().hex[:8], class_name="CustomClass",
        win_type=WindowType.MODAL_WINDOW,
        bounds=WindowRect(left=400, top=200, right=900, bottom=500),
        is_visible=True, has_focus=False, text_content="", extra_data={},
    )
    t0 = time.perf_counter()
    _success, _x, _y, action = mgr.resolve_and_mitigate(node)
    dur = time.perf_counter() - t0
    # The pre-fix stall was ~35 s. A capped Tier-3 must return well inside cap+slack.
    fast = dur < (GATEKEEPER_TIER3_TIMEOUT_S + 6.0)
    return TestOutcome(
        passed=cap_ok and fast,
        evidence=(
            f"Tier-3 cap={GATEKEEPER_TIER3_TIMEOUT_S:.1f}s (must be <=5s): "
            f"{'OK' if cap_ok else 'TOO HIGH'}; unresolvable modal resolved in {dur:.2f}s "
            f"-> action={action!r}; no multi-30s stall: {'OK' if fast else 'STALLED'}"
        ),
        metrics={"tier3_cap_s": round(GATEKEEPER_TIER3_TIMEOUT_S, 2),
                 "resolve_s": round(dur, 2), "fell_through": fast},
    )


def test_pl1_popup_lexical_tier() -> TestOutcome:
    """PL1: organ_29 Tier-2.5 lexical intent resolves known categories instantly,
    escalates elevation/destructive to human, and never clicks/blind-types in test"""
    from core_organs.organ_29_popup_handler import (
        DesktopInteractionManager, WindowNode, WindowRect, WindowType,
    )

    mgr = DesktopInteractionManager()
    # Dry-run: capture key intents instead of firing real hardware keystrokes.
    pressed = []
    mgr._execute_key_intent = lambda action, hwnd=0: (pressed.append(action), True)[1]

    def node(title, wtype, text=""):
        return WindowNode(
            handle=0, parent_handle=None, owner_handle=None, process_id=os.getpid(),
            title=title, class_name="", win_type=wtype,
            bounds=WindowRect(left=100, top=100, right=500, bottom=400),
            text_content=text)

    checks, detail = [], []
    # 1. Pure lexical decisions (no side effects)
    uac = mgr._lexical_intent_decision(node("A program needs your permission", WindowType.AUTHENTICATION))
    checks.append(uac == ("key:escape", True)); detail.append(f"uac->{uac}")
    destr = mgr._lexical_intent_decision(node("Save changes to Untitled?", WindowType.CONFIRMATION))
    checks.append(destr is not None and destr[1] is True); detail.append(f"destructive->{destr}")
    crash = mgr._lexical_intent_decision(node("App.exe has stopped working", WindowType.CRASH_REPORTER))
    checks.append(crash == ("key:escape", False)); detail.append(f"crash->{crash}")
    info = mgr._lexical_intent_decision(node("Setup complete", WindowType.MESSAGE_BOX))
    checks.append(info == ("key:enter", False)); detail.append(f"msgbox->{info}")
    ambig = mgr._lexical_intent_decision(node("zz-ambiguous-" + uuid.uuid4().hex[:6], WindowType.UNKNOWN))
    checks.append(ambig is None); detail.append(f"ambiguous->{ambig}")

    # 2. Full pipeline: novel cookie consent must resolve at Tier-2.5 (no Tier-3 LLM)
    cookie_title = "zz-cookie-" + uuid.uuid4().hex[:8]
    t0 = time.perf_counter()
    ok, _x, _y, act = mgr.resolve_and_mitigate(
        node(cookie_title, WindowType.COOKIE_BANNER, text="we value your privacy cookies"))
    dur = time.perf_counter() - t0
    checks.append(ok and act == "key:escape" and dur < 2.0)
    detail.append(f"cookie live-resolved in {dur:.2f}s via {act}")

    # 3. Escalation: UAC-like modal returns need_human and fires NO keystroke
    before = len(pressed)
    ok2, _x2, _y2, act2 = mgr.resolve_and_mitigate(
        node("zz-uac-" + uuid.uuid4().hex[:8], WindowType.AUTHENTICATION,
             text="wants to make changes to your PC"))
    checks.append((not ok2) and act2 == "need_human" and len(pressed) == before)
    detail.append(f"uac->{act2}, pressed={len(pressed) - before} (must be 0)")

    # 4. Repeat encounter: step 2 cached 'key:escape' -> Tier-2 replay, no lexical/LLM needed
    pressed.clear()
    t1 = time.perf_counter()
    ok3, _x3, _y3, act3 = mgr.resolve_and_mitigate(node(cookie_title, WindowType.COOKIE_BANNER))
    dur3 = time.perf_counter() - t1
    checks.append(ok3 and act3 == "key:escape" and pressed == ["key:escape"] and dur3 < 1.0)
    detail.append(f"repeat hit cache in {dur3:.2f}s replay={pressed}")

    return TestOutcome(
        passed=all(checks),
        evidence=f"{sum(checks)}/{len(checks)} lexical checks: " + " ; ".join(detail),
        metrics={"checks": f"{sum(checks)}/{len(checks)}", "first_resolve_s": round(dur, 2)},
    )


def test_sk1_recipe_distillation() -> TestOutcome:
    """SK1: loop distills verified steps into a reusable organ_04 skill recipe and recalls it"""
    from core_organs.desktop_grounding import DesktopAutonomyLoop, StepTrace

    root = os.path.join(os.environ.get("TEMP", "."), "hj_skill_" + uuid.uuid4().hex[:8])
    prev = os.environ.get("HOJAIGA_KNOWLEDGE_ROOT")
    os.environ["HOJAIGA_KNOWLEDGE_ROOT"] = root
    try:
        loop = DesktopAutonomyLoop(session_id="sk_" + uuid.uuid4().hex[:6])
        # Only >=2 VERIFIED (PASS) steps qualify as a trustworthy recipe.
        loop.trace = [
            StepTrace("open file menu", "File", "click", "PASS", "uia-invoke", "ui-changed", ["uia"]),
            StepTrace("save as chair", "Save As", "invoke", "PASS", "physical", "file-created", ["win32"]),
        ]
        ok, note = loop.distill_recipe("save file as chair", "notepad")
        recalled = DesktopAutonomyLoop.recall_recipe("save file as chair", "notepad")
        recall_hit = bool(recalled) and "SKILL[notepad]" in recalled

        # A thin trace (one PASS) must refuse to distill — no garbage recipes.
        loop.trace = [StepTrace("only one", "x", "click", "PASS", "m", "e", ["uia"])]
        ok_thin, note_thin = loop.distill_recipe("nothing", "notepad")
        refuses = (not ok_thin) and "not enough" in note_thin.lower()
        passed = bool(ok) and refuses and recall_hit
        return TestOutcome(
            passed=passed,
            evidence=f"2-PASS trace -> distill={ok} ({note}); recall_hit={recall_hit}; 1-PASS trace -> "
                     f"refused={not ok_thin} ({note_thin})",
            metrics={"distilled": bool(ok), "thin_refused": refuses, "recall_hit": recall_hit},
        )
    finally:
        if prev is None:
            os.environ.pop("HOJAIGA_KNOWLEDGE_ROOT", None)
        else:
            os.environ["HOJAIGA_KNOWLEDGE_ROOT"] = prev


def test_cp1_checkpoint_resume() -> TestOutcome:
    """CP1: loop persists a resumable checkpoint after each verified step and resumes"""
    from core_organs.desktop_grounding import DesktopAutonomyLoop, StepTrace

    sid = "cp_" + uuid.uuid4().hex[:8]
    loop = DesktopAutonomyLoop(session_id=sid)
    entry = StepTrace("save file", "Save", "click", "PASS", "uia-invoke", "ui-changed", ["uia"])
    loop.trace.append(entry)
    loop._write_checkpoint(entry)
    loaded = DesktopAutonomyLoop.load_checkpoint(sid)
    present = bool(loaded) and loaded.get("last", {}).get("verdict") == "PASS"
    steps_ok = bool(loaded) and loaded.get("steps", 0) >= 1
    missing = DesktopAutonomyLoop.load_checkpoint("no_such_session_zzz")
    clean_absent = missing is None

    # Test resume_session method
    loop2 = DesktopAutonomyLoop(session_id="new_ses")
    resumed = loop2.resume_session(sid)
    resume_ok = bool(resumed) and len(loop2.trace) >= 1 and loop2.trace[0].goal == "save file"

    passed = present and steps_ok and clean_absent and resume_ok
    return TestOutcome(
        passed=passed,
        evidence=(
            f"checkpoint round-trip: last-verdict-recovered={present}, "
            f"steps={loaded.get('steps') if loaded else 0}, "
            f"unknown-session->None={clean_absent}, resume_session={resume_ok}"
        ),
        metrics={"recovered": present, "unknown_absent": clean_absent, "resumed": resume_ok},
    )


def test_tg1_taskgraph_blender_chair() -> TestOutcome:
    """TG1: 'I'm busy, model a 3D chair from scratch' compiles to skip-ReAct native graph"""
    from core_organs.task_graph_compiler import compile_user_task
    from core_organs.native_app_runtime import generate_blender_bpy

    g = compile_user_task("open blender, model a 3D chair from scratch and save chair.blend")
    skip_react = g.skip_react
    mode = g.mode
    kind = g.object_kind
    save = os.path.basename(g.save_path)
    steps_len = len(g.steps)

    bpy = generate_blender_bpy("chair", "chair.blend")
    bpy_ok = "primitive_cube_add" in bpy and "save_as_mainfile" in bpy

    g_calc = compile_user_task("calculate 25 * 4 in calculator")
    calc_react = (not g_calc.skip_react) and g_calc.mode == "react_fallback"

    passed = skip_react and mode == "native_runtime" and kind == "chair" and bpy_ok and calc_react
    # No 3D suite installed on this host => the compiler correctly refuses to plan it: environmental.
    env_no_3d = (not passed) and "no 3d suite installed" in str(g.reason).lower() and bpy_ok and calc_react
    return TestOutcome(
        passed=passed,
        env_blocked=env_no_3d,
        evidence=(
            f"graph skip_react={skip_react} mode={mode} kind={kind} save={save} "
            f"steps={steps_len} reason={g.reason!r}; bpy_recipe={'OK' if bpy_ok else 'FAIL'}; "
            f"calculator_kept_react={calc_react}"
        ),
        metrics={"mode": mode, "steps": steps_len, "vision_tier": g.vision_tier},
    )


def test_w6_web_url_hygiene() -> TestOutcome:
    """W6: _derive_web_url resolves brand destinations without the goto.com verb alias bug"""
    from core_organs.organ_01_crewai_engine import _derive_web_url, _is_site_like_target

    checks = []
    # 1. "go to gmail" must NOT become goto.com
    u1 = _derive_web_url("go to gmail", "go to")
    checks.append(("gmail_not_goto", u1 == "https://www.gmail.com", f"go to gmail -> {u1}"))

    # 2. "goto gmail" must NOT become goto.com
    u2 = _derive_web_url("goto gmail", "goto")
    checks.append(("goto_alias_gmail", u2 == "https://www.gmail.com", f"goto gmail -> {u2}"))

    # 3. "open browser and check gmail" -> gmail.com
    u3 = _derive_web_url("open browser and check gmail", "open")
    checks.append(("browser_and_gmail", u3 == "https://www.gmail.com", f"open browser and check gmail -> {u3}"))

    # 4. generic phrase without brand destination -> google search fallback (never bogus domain)
    u4 = _derive_web_url("browse hotel deals online", "browse")
    checks.append(("generic_search_fallback", u4 == "https://www.google.com", f"browse hotel deals -> {u4}"))

    # 5. explicit URL preserved
    u5 = _derive_web_url("open https://news.ycombinator.com/item?id=1", "")
    checks.append(("explicit_url", u5 == "https://news.ycombinator.com/item?id=1", f"explicit -> {u5}"))

    # 6. _is_site_like_target rejects verb aliases
    c_goto = _is_site_like_target("goto")
    c_gmail = _is_site_like_target("gmail")
    checks.append(("target_ordering", (not c_goto) and c_gmail, f"is_site(goto)={c_goto}, is_site(gmail)={c_gmail}"))

    passed = all(ok for _, ok, _ in checks)
    evidence = "; ".join(msg for _, _, msg in checks)
    return TestOutcome(
        passed=passed,
        evidence=f"{sum(1 for _, ok, _ in checks)}/{len(checks)} hygiene checks: {evidence}",
        metrics={"checks": f"{sum(1 for _, ok, _ in checks)}/{len(checks)}"},
    )


def test_w8_app_intelligence_pro_learning() -> TestOutcome:
    """W8: organ_47 turns verified outcomes into pro shortcuts — and never trusts a guess"""
    import tempfile
    from core_organs.organ_47_app_intelligence import AppIntelligence, classify_archetype

    tmpdb = os.path.join(tempfile.gettempdir(), "hj_intel_" + uuid.uuid4().hex[:8] + ".db")
    intel = AppIntelligence(db_path=tmpdb)
    try:
        # (1) archetype routing is family-based, data-driven, no per-app code.
        arch_ok = (classify_archetype("blender") == "3d_suite"
                   and classify_archetype("photoshop") == "raster_editor")
        # (2) a fresh app yields only UNVERIFIED archetype hints (never 'learned'),
        #     so an unverified guess can never take direct control of the machine.
        intel.register_app("zzproapp", source="observed")
        pb0 = intel.playbook("zzproapp", "save", allow_llm_briefing=False)
        unverified_not_learned = all(h.source != "learned" for h in pb0.hints)
        # (3) learning from a VERIFIED PASS turns into a trusted shortcut.
        for _ in range(1):
            intel.record_step("zzproapp", "save", "key", shortcut="ctrl+s",
                              element_role="shortcut", outcome="PASS", source="learned")
        pb1 = intel.playbook("zzproapp", "save", allow_llm_briefing=False)
        top = pb1.hints[0] if pb1.hints else None
        learned_top = bool(top and top.source == "learned" and top.shortcut == "ctrl+s"
                           and top.confidence >= 0.70)
        first_conf = float(top.confidence) if top else 0.0
        # (4) repeated success climbs monotonically toward the 0.97 ceiling.
        for _ in range(6):
            intel.record_step("zzproapp", "save", "key", shortcut="ctrl+s",
                              element_role="shortcut", outcome="PASS", source="learned")
        pb2 = intel.playbook("zzproapp", "save", allow_llm_briefing=False)
        climb_conf = float(pb2.hints[0].confidence)
        climb_ok = first_conf < climb_conf <= 0.97 + 1e-6
        # (5) failure erodes confidence fast — a shortcut that stopped working
        #     loses its direct-control privilege rather than staying trusted.
        intel.record_step("zzproapp", "print", "key", shortcut="ctrl+p",
                          element_role="shortcut", outcome="PASS", source="learned")
        cbefore = [h.confidence for h in intel.playbook("zzproapp", "print", False).hints
                   if h.shortcut == "ctrl+p"][0]
        intel.record_step("zzproapp", "print", "key", shortcut="ctrl+p",
                          element_role="shortcut", outcome="FAIL", source="learned")
        cafter = [h.confidence for h in intel.playbook("zzproapp", "print", False).hints
                  if h.shortcut == "ctrl+p"][0]
        erode_ok = cafter < cbefore
        checks = [arch_ok, unverified_not_learned, learned_top, climb_ok, erode_ok]
        passed = all(checks)
        return TestOutcome(
            passed=passed,
            evidence=(
                f"archetype-route={'OK' if arch_ok else 'FAIL'}; "
                f"guess-never-learned={'OK' if unverified_not_learned else 'FAIL'}; "
                f"verified-ctrl+s-trusted={'OK' if learned_top else 'FAIL'}(conf {first_conf:.2f}); "
                f"climbs-to-cap={'OK' if climb_ok else 'FAIL'}({first_conf:.2f}->{climb_conf:.2f}); "
                f"failure-erodes={'OK' if erode_ok else 'FAIL'}({cbefore:.2f}->{cafter:.2f})"
            ),
            metrics={"checks": f"{sum(1 for c in checks if c)}/{len(checks)}",
                     "learned_confidence": round(climb_conf, 3)},
        )
    finally:
        intel.close()
        try:
            os.remove(tmpdb)
        except Exception:
            pass



# ═══════════════════════════════════════════════════════════════════════
# OUTSTANDING-ISSUES FIX PLAN: vision budget/cache, blank parse, PL2, W9, E2E
# ═══════════════════════════════════════════════════════════════════════

def _vision_ready_or_blocked(timeout_s: float = 300.0):
    """(ready, ENV-BLOCKED outcome | None). A warmup that fails or times out is an ENVIRONMENT result that must be
    SAID - never a silent skip that lets a vision test pass without vision."""
    from core_organs import desktop_grounding as dg
    ready = dg.DesktopGrounding.wait_vision_ready(timeout_s)
    if ready:
        return True, None
    warm = dict(dg.DesktopGrounding._warm)
    return False, TestOutcome(
        passed=False, env_blocked=True,
        evidence=f"ENV-BLOCKED: vision warmup did not become ready within {timeout_s:.0f} s "
                 f"(state={warm.get('state')}, result={warm.get('result')}); the vision tier cannot be measured on this host right now")


def test_g2_vision_budget_cache_timing() -> TestOutcome:
    """G2: vision tier is budgeted per goal, cached per window signature, and per-tier ms is reported - with the REAL OmniParser, instrumented"""
    from core_organs import si_test_support as sup
    from core_organs import desktop_grounding as dg

    if not (dg.HAS_TORCH and dg.HAS_PIL and os.path.isdir(dg.OMNI_LOCAL_REPO)):
        return TestOutcome(passed=False, env_blocked=True,
                           evidence="vision prerequisites missing (torch/PIL/OmniParser repo)")
    t_w = time.perf_counter()
    ready, blocked = _vision_ready_or_blocked(300.0)
    if not ready:
        return blocked
    warm_wait_ms = (time.perf_counter() - t_w) * 1000

    parser = dg.DesktopGrounding._get_vision_parser()
    if parser is None:
        return TestOutcome(passed=False, env_blocked=True, evidence="OmniParser reported itself unavailable after warmup")
    calls: List[Dict[str, Any]] = []
    real_parse = parser.parse_screenshot

    def instrumented(path):
        t0 = time.perf_counter()
        els = real_parse(path)
        calls.append({"ms": round((time.perf_counter() - t0) * 1000, 1), "elements": len(els or [])})
        return els
    parser.parse_screenshot = instrumented
    win = sup.NativeButtonWindow(title="HJ-G2-VisionProbe").start()
    try:
        g = dg.DesktopGrounding()
        absent = "zz_absent_widget_zz"
        # 1st ground: vision runs (cache miss) - the REAL parser
        _h, _e, r1 = g.ground(win.title, target_text=absent, max_tier=4)
        n_after_first = len(calls)
        cold_parse_ms = calls[0]["ms"] if calls else None
        # 2nd ground, identical pixels, inside the TTL: cache hit, parser NOT called again
        _h, _e, r2 = g.ground(win.title, target_text=absent, max_tier=4)
        cache_hit = bool(r2.get("vision_cache_hit")) and len(calls) == n_after_first
        t_cached = r2["tier_ms"].get("vision", 9e9)
        # Budget: force misses by clearing the cache; calls beyond VISION_MAX_CALLS are refused
        g.reset_vision_budget()
        n0 = len(calls)
        reports = []
        for _ in range(dg.VISION_MAX_CALLS + 1):
            g._vision_cache.clear()
            reports.append(g.ground(win.title, target_text=absent, max_tier=4)[2])
        ran = len(calls) - n0
        budget_enforced = ran == dg.VISION_MAX_CALLS and any(
            "vision:budget-exhausted" in rp.get("tiers_skipped", []) for rp in reports)
        # New goal => budget refilled
        g.reset_vision_budget()
        g._vision_cache.clear()
        n1 = len(calls)
        g.ground(win.title, target_text=absent, max_tier=4)
        refilled = len(calls) == n1 + 1
        tier_ms_ok = all(k in r1["tier_ms"] for k in ("uia", "vision")) and "ocr" in r1["tier_ms"]
        parse_ms = [c["ms"] for c in calls]
        passed = (n_after_first == 1 and cache_hit and budget_enforced and refilled and tier_ms_ok)
        speedup = (cold_parse_ms / t_cached) if (cold_parse_ms and t_cached and t_cached > 0) else None
        return TestOutcome(
            passed=passed,
            evidence=(f"REAL OmniParser (warm, waited {warm_wait_ms:.0f} ms for the warmup thread): first ground ran vision "
                      f"{n_after_first}x, parse {cold_parse_ms} ms; 2nd identical window cache_hit={cache_hit} "
                      f"({t_cached} ms vs {r1['tier_ms'].get('vision')} ms miss{f', x{speedup:.0f}' if speedup else ''}); budget "
                      f"{dg.VISION_MAX_CALLS}/goal enforced={budget_enforced} (ran {ran} of {dg.VISION_MAX_CALLS + 1} attempts); "
                      f"refill-on-new-goal={refilled}; all {len(calls)} real parses (ms)={parse_ms}; "
                      f"measured per-tier ms (miss)={r1['tier_ms']}"),
            metrics={"cache_hit": cache_hit, "budget_enforced": budget_enforced, "refilled": refilled,
                     "real_parse_ms": parse_ms, "tier_ms_miss": str(r1["tier_ms"]), "tier_ms_hit": t_cached},
        )
    finally:
        parser.parse_screenshot = real_parse
        win.stop()


def test_om1_blank_image_parse_and_warmup() -> TestOutcome:
    """OM1: real OmniParser warmup (easyocr download happens once) + blank image = 0 elements, no ERROR"""
    import logging
    from PIL import Image
    from core_organs import desktop_grounding as dg

    if not (dg.HAS_TORCH and dg.HAS_PIL and os.path.isdir(dg.OMNI_LOCAL_REPO)):
        return TestOutcome(passed=False, env_blocked=True,
                           evidence="vision prerequisites missing (torch/PIL/OmniParser repo)")
    warm = dg.DesktopGrounding.warmup_vision()
    if not warm.get("warmed"):
        return TestOutcome(passed=False, env_blocked=True,
                           evidence=f"OmniParser could not warm up: {warm}")

    class _Capture(logging.Handler):
        def __init__(self):
            super().__init__(level=logging.INFO)
            self.records = []

        def emit(self, record):
            self.records.append(record)

    cap = _Capture()
    log = logging.getLogger("core_organs.organ_44_enhanced_scanner")
    root_names = ["core_organs.organ_44_enhanced_scanner", "organ_44_enhanced_scanner", ""]
    loggers = [logging.getLogger(n) for n in root_names]
    for lg in loggers:
        lg.addHandler(cap)
    blank = os.path.join(os.environ.get("TEMP", "."), "hj_blank_" + uuid.uuid4().hex[:6] + ".png")
    try:
        Image.new("RGB", (640, 400), "white").save(blank)
        parser = dg.DesktopGrounding._get_vision_parser()
        t0 = time.perf_counter()
        els = parser.parse_screenshot(blank)
        dur = (time.perf_counter() - t0) * 1000
    finally:
        for lg in loggers:
            lg.removeHandler(cap)
        try:
            os.remove(blank)
        except Exception:
            pass
    errors = [r.getMessage() for r in cap.records
              if r.levelno >= logging.ERROR and "OmniParser" in r.getMessage()]
    passed = (els == []) and not errors
    return TestOutcome(
        passed=passed,
        evidence=(f"warmup {warm['ms']} ms (warmed={warm['warmed']}); blank 640x400 PNG -> {len(els)} elements "
                  f"in {dur:.0f} ms; ERROR-level logs={len(errors)} {errors[:1]}"),
        metrics={"warmup_ms": warm["ms"], "blank_parse_ms": round(dur), "error_logs": len(errors)},
    )


def test_pl2_popup_fingerprint_cache() -> TestOutcome:
    """PL2: dynamic-title popups hit the class+button fingerprint cache; real DB round-trips it"""
    from core_organs.organ_29_popup_handler import (
        DesktopInteractionManager, WindowNode, WindowRect, WindowType, normalize_popup_title,
    )

    os.environ["HOJAIGA_POPUP_PREWARM"] = "0"

    class _MemDB:
        def __init__(self):
            self.rows = []

        def generate_layout_hash(self, t):
            return t

        def check_popup_history(self, title):
            for r in self.rows:
                if r["title"] == title:
                    return r
            return None

        def check_popup_fingerprint(self, fp):
            for r in self.rows:
                if r["fingerprint"] == fp:
                    return r
            return None

        def log_new_pathway(self, layout_hash, element_name, x, y, action_type, parent_path="",
                            fingerprint=""):
            self.rows.append({"title": element_name, "x": x, "y": y, "action": action_type,
                              "parent_path": parent_path, "fingerprint": fingerprint})

    def node(title, cls="#32770"):
        return WindowNode(
            handle=0, parent_handle=None, owner_handle=None, process_id=os.getpid(),
            title=title, class_name=cls, win_type=WindowType.UNKNOWN,
            bounds=WindowRect(left=100, top=100, right=500, bottom=400),
            extra_data={"buttons": ["Retry", "Cancel"]})

    mgr = DesktopInteractionManager()
    mgr.db = _MemDB()
    pressed = []
    mgr._execute_key_intent = lambda a, hwnd=0: (pressed.append(a), True)[1]

    checks, detail = [], []
    n1 = node("Installer Error 0x80070005 (attempt 3)")
    n2 = node("Installer Error 0x8007271D (attempt 17)")
    n3 = node("Totally Different Dialog")
    n4 = node("Installer Error 0x80070005 (attempt 3)", cls="OtherClass")
    fp1, fp2 = mgr.popup_fingerprint(n1), mgr.popup_fingerprint(n2)
    checks.append(fp1 == fp2 and fp1 != mgr.popup_fingerprint(n3) and fp1 != mgr.popup_fingerprint(n4))
    detail.append(f"normalize->'{normalize_popup_title(n1.title)}', fp-stable={fp1 == fp2}, "
                  f"distinct-for-other-class/title={fp1 != mgr.popup_fingerprint(n4)}")

    # Learn n1 (as a prior Tier-4/Tier-3 outcome would), then resolve n2 with a DIFFERENT title.
    mgr._log_pathway(n1, 0, 0, "key:escape", "organ_29_tier4_escape_cached")
    t0 = time.perf_counter()
    ok, _x, _y, act = mgr.resolve_and_mitigate(n2)
    dur = time.perf_counter() - t0
    hit = ok and act == "key:escape" and pressed == ["key:escape"] and dur < 1.0
    checks.append(hit)
    detail.append(f"different-title popup resolved via fingerprint cache in {dur * 1000:.0f} ms -> {act}")
    checks.append(mgr.db.check_popup_history(n2.title) is None)
    detail.append("exact-title lookup alone would have MISSED (the pre-fix behaviour)")

    # Real database round-trip of the fingerprint column-in-JSON
    real_note = "real-db: skipped"
    try:
        from core_organs.database_manager import DatabaseManager
        db = DatabaseManager()
        uniq = "zz-pl2-" + uuid.uuid4().hex[:8]
        fp = DesktopInteractionManager.__new__(DesktopInteractionManager)
        fp_val = uuid.uuid4().hex
        db.log_new_pathway(db.generate_layout_hash(uniq), uniq, 7, 9, "key:escape", "pl2-test",
                           fingerprint=fp_val)
        got = db.check_popup_fingerprint(fp_val)
        real_ok = bool(got) and got.get("action") == "key:escape"
        checks.append(real_ok)
        real_note = f"real-db fingerprint round-trip={'OK' if real_ok else 'MISS'}"
    except Exception as exc:  # noqa: BLE001
        return TestOutcome(passed=False, env_blocked=True,
                           evidence=f"database unreachable ({type(exc).__name__}: {exc}); in-memory checks: "
                                    + "; ".join(detail))
    detail.append(real_note)
    return TestOutcome(passed=all(checks), evidence="; ".join(detail),
                       metrics={"fingerprint_resolve_ms": round(dur * 1000, 1)})


def test_w9_compiled_nav_step_url() -> TestOutcome:
    """W9: the compiled WEB.NAVIGATE step (what pre-navigation uses) never carries goto.com"""
    from core_organs.organ_01_crewai_engine import _compile_task_with_organ36, _derive_web_url

    cases = [("go to gmail and check my inbox", "gmail.com"), ("goto gmail", "gmail.com"),
             ("open chrome and go to gmail.com", "gmail.com"), ("navigate to figma", "figma.com")]
    bad, ok_n, detail = [], 0, []
    for cmd, want in cases:
        comp = _compile_task_with_organ36(cmd)
        nav = [st for st in comp.get("steps", []) if st.get("capability") == "WEB.NAVIGATE"]
        url = (nav[0].get("parameters") or {}).get("url") if nav else _derive_web_url(cmd, "")
        good = bool(url) and want in url and "goto" not in url
        ok_n += int(good)
        detail.append(f"'{cmd}' -> {url}")
        if not good:
            bad.append(cmd)
    return TestOutcome(passed=not bad, evidence=f"{ok_n}/{len(cases)} compiled nav URLs correct: " + "; ".join(detail),
                       metrics={"correct": f"{ok_n}/{len(cases)}"})


