# DEEP SCANNING
# ═══════════════════════════════════════════════════════════════════════

def _enum_candidate_windows() -> List[Dict[str, Any]]:
    """Visible top-level windows that own a title bar (real apps, not tool
    strips). Used to pick a stable, rich scan target instead of whatever is
    incidentally in the foreground."""
    import ctypes.wintypes as wt
    user32 = ctypes.windll.user32
    found: List[Dict[str, Any]] = []

    @ctypes.WINFUNCTYPE(ctypes.c_bool, wt.HWND, wt.LPARAM)
    def cb(hwnd, lparam):
        if user32.IsWindowVisible(hwnd) and user32.GetWindowTextLengthW(hwnd) > 2:
            r = wt.RECT()
            if user32.GetWindowRect(hwnd, ctypes.byref(r)):
                w, h = r.right - r.left, r.bottom - r.top
                if w > 200 and h > 200:
                    n = user32.GetWindowTextLengthW(hwnd)
                    buf = ctypes.create_unicode_buffer(n + 1)
                    user32.GetWindowTextW(hwnd, buf, n + 1)
                    found.append({"hwnd": hwnd, "title": buf.value, "area": w * h})
        return True

    user32.EnumWindows(cb, 0)
    return found


def test_s1_deep_scan_depth() -> TestOutcome:
    """S1: Organ-30 deep scan — how deep and how much it learns (target-aware)"""
    from core_organs.organ_30_app_scanner import EyeAndBrainOrchestrator

    user32 = ctypes.windll.user32
    fg = user32.GetForegroundWindow()
    candidates: List[Dict[str, Any]] = []
    if fg:
        candidates.append({"hwnd": fg, "title": "<foreground>", "area": 0})
    for c in _enum_candidate_windows():
        if c["hwnd"] != fg:
            candidates.append(c)

    orch = EyeAndBrainOrchestrator()

    def scan(hwnd):
        t = time.perf_counter()
        r = orch.deep_scan_unknown_app(app_name="s1-target", target_hwnd=hwnd, quiet=True)
        s = r.get("tree_stats", {})
        return s.get("nodes_walked", 0), s.get("max_depth_seen", 0), \
            s.get("walk_max_depth", 0), r.get("total_elements", 0), \
            r.get("total_controls", 0), r.get("total_menu_items", 0), time.perf_counter() - t

    # Try targets richest-first until the scanner demonstrates real depth.
    best = None
    tried = 0
    for cand in candidates[:4]:
        tried += 1
        nodes, depth_seen, depth_cap, elements, controls, menus, elapsed = scan(cand["hwnd"])
        if best is None or nodes > best[0]:
            best = (nodes, depth_seen, depth_cap, elements, controls, menus, elapsed, cand["title"])
        if nodes > 50 and elements > 0 and depth_seen >= 6:
            break
    if best is None:  # no scannable window at all — environmental, not a defect
        return TestOutcome(passed=False, env_blocked=True,
                           evidence="S1: no visible window with a title bar to scan (environment)",
                           metrics={})
    nodes, depth_seen, depth_cap, elements, controls, menus, elapsed, title = best

    evidence = (
        f"scanned {tried} target(s); best='{title[:28]}': {nodes} nodes walked, "
        f"depth {depth_seen}/{depth_cap}, {controls} actionable controls, "
        f"{menus} menu items, {elements} elements learned in {elapsed:.2f}s"
    )
    return TestOutcome(
        passed=nodes > 50 and elements > 0 and depth_seen >= 6,
        evidence=evidence,
        metrics={"nodes_walked": nodes, "depth_seen": depth_seen, "depth_cap": depth_cap,
                 "actionable_controls": controls, "elements_learned": elements,
                 "scan_seconds": round(elapsed, 3), "targets_tried": tried},
    )


def test_s2_continuous_scanner_cycles() -> TestOutcome:
    """S2: Organ-41 continuous scanner — real cycles, change detection, budget behaviour"""
    from core_organs.organ_41_scanner import ScannerOrgan

    organ = ScannerOrgan()
    cycles, diffs, times_ms = [], 0, []
    prev_hash = None

    def one_cycle():
        nonlocal prev_hash
        t0 = time.perf_counter()
        snap = organ._capture_snapshot()
        times_ms.append((time.perf_counter() - t0) * 1000)
        assert snap is not None, "scanner returned empty snapshot"
        h = getattr(snap, "hash", "")
        elements = getattr(snap, "elements", []) or []
        changed = prev_hash is not None and h != prev_hash
        prev_hash = h
        return changed, len(elements)

    for _ in range(3):
        changed, n = one_cycle()
        diffs += changed
        cycles.append(n)

    # Real mutation: spawn a throwaway app owned by this test, detect the UI
    # change, then clean it up again.
    import subprocess
    notepads_before = _windows_of_class("Notepad")
    proc = subprocess.Popen(["notepad.exe"])
    try:
        time.sleep(1.2)  # let the window appear
        changed, n = one_cycle()
        diffs += changed
        cycles.append(n)
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=3)
        except Exception:
            pass
        _close_new_windows_of(notepads_before, "Notepad")      # only the window THIS test opened
    time.sleep(0.6)
    changed, n = one_cycle()  # window gone -> should change again
    diffs += changed
    cycles.append(n)
    avg = sum(times_ms) / len(times_ms)
    return TestOutcome(
        passed=avg > 0 and max(cycles) >= 1 and diffs >= 1,
        evidence=(
            f"{len(times_ms)} cycles (incl. real notepad spawn/kill mutation), avg {avg:.0f} ms/cycle "
            f"(min {min(times_ms):.0f} max {max(times_ms):.0f}), "
            f"{diffs} change-detections (expected >=2), peak elements {max(cycles)}"
        ),
        metrics={"avg_cycle_ms": round(avg, 1), "min_cycle_ms": round(min(times_ms), 1),
                 "max_cycle_ms": round(max(times_ms), 1), "change_detections": diffs,
                 "peak_elements": max(cycles)},
    )


