# KNOWLEDGE (organ_04) — natural-language ingestion & retrieval
# ═══════════════════════════════════════════════════════════════════════

def test_k1_knowledge_ingest_and_natural_search() -> TestOutcome:
    """K1: Knowledge organ ingests prose documents and retrieves them by meaning"""
    from core_organs.organ_04_knowledge import KnowledgeOrgan, QueryDispatcher

    root = os.path.join(os.environ.get("TEMP", "."), "hojaiga_know_test_" + uuid.uuid4().hex[:8])
    organ = KnowledgeOrgan(root_dir=root)

    async def flow():
        await organ.start()
        dispatcher = organ.dispatcher
        assert dispatcher is not None, "knowledge dispatcher not initialized"
        try:
            docs = [
                "# SSMS error dialogs\nWhen SQL Server Management Studio shows 'A required privilege is not held', "
                "re-register the instance and dismiss the modal with Cancel.",
                "# Paint canvas behaviour\nMS Paint exposes its drawing surface as a Canvas control with no UIA "
                "children, so shape tools must be driven by pixel coordinates and the virtual mouse.",
                "# Chrome profile picker\nIf Chrome opens the profile selection screen, click the 'Personal' "
                "profile tile before navigating; inject session cookies afterwards.",
            ]
            ingested = 0
            t0 = time.perf_counter()
            for text in docs:
                res = await dispatcher.dispatch(
                    QueryDispatcher.OP_INGEST_KNOWLEDGE,
                    {"doc_type": "manual", "content_text": text},
                )
                ingested += res.get("ingested_chunks", 0) or 0
            ingest_ms = (time.perf_counter() - t0) * 1000
            # (paraphrased query, title fragment that SHOULD come back)
            queries = [
                ("how do we handle the sql server dialog", "ssms"),
                ("which app needs pixel coordinates to draw", "paint"),
            ]
            search_hits = 0
            results_detail = []
            for q, want in queries:
                res = await dispatcher.dispatch(
                    QueryDispatcher.OP_SEARCH_KNOWLEDGE, {"text": q, "limit": 3}
                )
                matches = res.get("matches", []) if isinstance(res, dict) else []
                titles = [str(m.get("title", "")).lower() for m in matches]
                relevance = any(want in t for t in titles)
                if matches and relevance:
                    search_hits += 1
                top = matches[0] if matches else None
                results_detail.append(
                    f"'{q[:32]}' -> top='{str(top.get('title')) if top else 'NONE'}'"
                    f" score={top.get('score') if top else '-'} {'RELEVANT' if relevance else 'IRRELEVANT'}"
                )
            cap = await dispatcher.dispatch(
                QueryDispatcher.OP_RESOLVE_CAPABILITY,
                {"request_id": "t", "capability": "launch_app"},
            )
            providers = cap.get("providers", []) if isinstance(cap, dict) else []
            return ingested, ingest_ms, search_hits, len(queries), results_detail, len(providers), cap
        finally:
            await organ.stop()

    ingested, ingest_ms, search_hits, n_queries, detail, providers, cap_raw = asyncio.run(flow())
    ok = ingested >= 3 and search_hits >= 1
    return TestOutcome(
        passed=ok,
        evidence=(
            f"{ingested} chunks ingested in {ingest_ms:.0f} ms; "
            f"{search_hits}/{n_queries} paraphrased queries returned the SEMANTICALLY correct doc; "
            f"capability 'launch_app' -> {providers} provider(s) | " + "; ".join(detail)
        ),
        metrics={"chunks_ingested": ingested, "semantic_queries_hit": f"{search_hits}/{n_queries}"},
    )


def test_k2_knowledge_speed() -> TestOutcome:
    """K2: How easily/fast the system parses knowledge — 50 ingest+search round trips"""
    from core_organs.organ_04_knowledge import KnowledgeOrgan, QueryDispatcher

    root = os.path.join(os.environ.get("TEMP", "."), "hojaiga_know_speed_" + uuid.uuid4().hex[:8])
    organ = KnowledgeOrgan(root_dir=root)

    async def flow():
        await organ.start()
        dispatcher = organ.dispatcher
        assert dispatcher is not None, "knowledge dispatcher not initialized"
        try:
            latencies = []
            for i in range(50):
                text = (f"# Fact {i}\nThe Hojaiga organ number {i} handles subsystem duty {i % 7} "
                        f"and reports to the CNS bus every {i + 1} seconds.")
                t0 = time.perf_counter()
                await dispatcher.dispatch(QueryDispatcher.OP_INGEST_KNOWLEDGE,
                                        {"doc_type": "facts", "content_text": text})
                await dispatcher.dispatch(QueryDispatcher.OP_SEARCH_KNOWLEDGE,
                                        {"text": f"organ {i} subsystem duty", "limit": 3})
                latencies.append((time.perf_counter() - t0) * 1000)
            return latencies
        finally:
            await organ.stop()

    lat = asyncio.run(flow())
    lat.sort()
    avg = sum(lat) / len(lat)
    p95 = lat[int(len(lat) * 0.95) - 1]
    return TestOutcome(
        passed=avg < 50,
        evidence=f"50 ingest+search round trips: avg {avg:.2f} ms, p50 {lat[len(lat)//2]:.2f} ms, p95 {p95:.2f} ms",
        metrics={"kg_roundtrip_avg_ms": round(avg, 3), "kg_roundtrip_p95_ms": round(p95, 3)},
    )


