def test_r1_working_memory_and_ttl() -> TestOutcome:
    """R1: Memory organ working store, fetch throughput, TTL expiry"""
    from core_organs.organ_03_memory import MemoryCore, MemoryClient

    core = MemoryCore()
    core.start()
    try:
        client = MemoryClient(core)
        N = 200
        t0 = time.perf_counter()
        for i in range(N):
            client.store_working(f"bench_{i}", {"idx": i, "payload": "x" * 64})
        store_ms = (time.perf_counter() - t0) * 1000
        t0 = time.perf_counter()
        fetched = sum(1 for i in range(N) if client.fetch_working(f"bench_{i}") is not None)
        fetch_ms = (time.perf_counter() - t0) * 1000
        # TTL expiry
        client.store_working("short_lived", {"gone": True}, ttl=1)
        alive_immediately = client.fetch_working("short_lived") is not None
        time.sleep(1.3)
        gone_after_ttl = client.fetch_working("short_lived") is None
        passed = fetched == N and alive_immediately and gone_after_ttl
        return TestOutcome(
            passed=passed,
            evidence=(
                f"{fetched}/{N} keys round-tripped; store {store_ms:.0f} ms "
                f"({store_ms/N:.3f} ms/op), fetch {fetch_ms:.0f} ms ({fetch_ms/N:.3f} ms/op); "
                f"TTL alive={alive_immediately}, expired={gone_after_ttl}"
            ),
            metrics={"store_ms_per_op": round(store_ms / N, 4),
                     "fetch_ms_per_op": round(fetch_ms / N, 4),
                     "keys_round_tripped": fetched},
        )
    finally:
        core.stop()


def test_r2_session_rooms_and_snapshot() -> TestOutcome:
    """R2: Memory session rooms, conversational history, snapshot persistence"""
    from core_organs.organ_03_memory import MemoryCore, MemoryClient

    core = MemoryCore()
    core.start()
    try:
        client = MemoryClient(core)
        room_id = client.create_room(metadata={"test": "r2"})
        for role, content in [("user", "open chrome"), ("agent", "chrome launched"),
                              ("user", "now find the address bar")]:
            client.append_context(room_id, role, content)
        history = client.history(room_id, depth=10)
        ok_history = len(history) == 3
        snap_id = client.snapshot("integration_test")
        ok_snap = bool(snap_id)
        return TestOutcome(
            passed=ok_history and ok_snap,
            evidence=f"room {room_id[:8]}: {len(history)} messages replayed, snapshot id={str(snap_id)[:16]}",
            metrics={"messages_replayed": len(history)},
        )
    finally:
        core.stop()


