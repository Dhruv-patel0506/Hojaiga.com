# Hojaiga — environments, models & binaries NEVER get committed.
# (The local working dir d:\new_automation keeps them; this repo does not.)

# Virtual envs / interpreters
.venv/
venv*/
hojaiga_env/
Scripts/
Lib/
Lib64/

# Python artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Model weights / ML assets (re-download, never commit)
models/
checkpoints/
*.pt
*.pth
*.onnx
*.engine
*.safetensors
*.ckpt
*.pkl
*.joblib
OmniParser/weights/
OmniParser/X-OMNI.zip
OmniParser/weights.zip
stable-diffusion-webui/
kokoro_models/

# Large binaries / archives / media
*.exe
*.dll
*.lib
*.pdb
*.obj
*.tlog
*.msi
*.zip
*.7z
*.tar
*.tar.gz
*.tar.xz
*.gz
*.mp4
*.avi
*.mkv
*.mov
*.webm
*.wav
*.mp3

# Browser profiles / caches / temp
.chrome*/
.test_*profile/
.test_upload/
.tmp*/
tmp/
tmp2/
.cache/
node_modules/
ipynb_checkpoints/

# Runtime output (regenerated constantly)
audit_logs*/
logs/
var/
db_backups/
evidence/
observation/
observations/
screenshots/
videos/
test_videos/
.test_harness_videos/
pixel-animation-video/
*.log
hatch_patterns.png

# Secrets / local config
.env
*.env
secrets*
*.key
*.pem

# Editor / tooling
.aider*
.qoder/
.kilo/
.vscode/
.idea/

*.snap

.claude/
